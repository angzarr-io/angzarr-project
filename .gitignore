# Node / Astro build artifacts (site-next has its own .gitignore; this covers stray clones)
node_modules/
dist/
.astro/

# Cruft inside vendored submodules (submodules themselves are tracked via .gitmodules)
vendor/*/*/node_modules/
vendor/*/*/.uv-cache/
vendor/*/*/target/
vendor/*/*/dist/

# OS
.DS_Store

# Editor / tooling
.idea/
.vscode/
.claude/
.gemini/
.mcp.json
.mcp.json.*.bak

# Env
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
