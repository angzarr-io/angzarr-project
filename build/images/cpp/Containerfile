# syntax=docker/dockerfile:1.4
# C++ build image for angzarr.
#
# Provides: clang/g++ (C++20), CMake, Ninja, protobuf (libprotobuf-dev +
# protoc), Catch2, lizard. angzarr (codegen/scaffold protoc plugins) + buf are
# inherited from base. The binding links the router-ffi STATICLIB directly
# (no runtime .so), carried forward via the shared target/ mount.
# Based on: ghcr.io/angzarr-io/angzarr-base (inherits fixuid + angzarr user)

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Toolchain + protobuf C++ runtime/compiler + Catch2 (test framework). libstdc++
# build-essential comes from base; clang gives a second compiler + clang-tidy.
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang \
    clang-tidy \
    cmake \
    ninja-build \
    protobuf-compiler \
    libprotobuf-dev \
    catch2 \
    && rm -rf /var/lib/apt/lists/*

# lizard (per-function cyclomatic complexity; `just complexity`). Python-based;
# --break-system-packages is needed under PEP 668 (Debian externally-managed).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --break-system-packages lizard

# Verify
RUN g++ --version && clang --version && cmake --version && \
    protoc --version && lizard --version && angzarr codegen languages

WORKDIR /workspace
USER angzarr
