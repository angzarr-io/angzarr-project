# syntax=docker/dockerfile:1.4
# Java build image for angzarr.
#
# Provides: JDK 25 (Temurin — FFM/Panama is final at 22+, so no preview flags),
# Gradle 9.1, protoc, PMD. angzarr (codegen/scaffold protoc plugins) + buf are
# inherited from base.
# Based on: ghcr.io/angzarr-io/angzarr-base (inherits fixuid + angzarr user)

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG JAVA_VERSION=25
ARG GRADLE_VERSION=9.1.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Temurin JDK (bookworm apt only ships 17; FFM needs 22+, so fetch the GA
# tarball from Adoptium). Installed system-wide, world-readable for any uid.
RUN ARCH="$(dpkg --print-architecture)" && \
    case "$ARCH" in \
        amd64) AARCH=x64 ;; \
        arm64) AARCH=aarch64 ;; \
        *) echo "unsupported arch $ARCH" >&2; exit 1 ;; \
    esac && \
    curl -fSL -o /tmp/jdk.tar.gz \
        "https://api.adoptium.net/v3/binary/latest/${JAVA_VERSION}/ga/linux/${AARCH}/jdk/hotspot/normal/eclipse?project=jdk" && \
    mkdir -p /opt/jdk && \
    tar -C /opt/jdk --strip-components=1 -xzf /tmp/jdk.tar.gz && \
    rm /tmp/jdk.tar.gz && \
    chmod -R a+rX /opt/jdk

ENV JAVA_HOME=/opt/jdk
ENV PATH=${JAVA_HOME}/bin:${PATH}

# Gradle 9.x (system-wide; world-readable). 9.1 is the first line to run on
# JDK 25.
RUN curl -Lo /tmp/gradle.zip \
        "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" && \
    unzip -d /opt /tmp/gradle.zip && \
    ln -s /opt/gradle-${GRADLE_VERSION} /opt/gradle && \
    rm /tmp/gradle.zip && \
    chmod -R a+rX /opt/gradle*

ENV PATH=/opt/gradle/bin:$PATH

# PMD (per-method cyclomatic complexity; `just complexity`). Standalone CLI —
# no Gradle plugin needed. Symlinked onto PATH; world-readable for any uid.
ARG PMD_VERSION=7.21.0
RUN curl -fsSL -o /tmp/pmd.zip \
        "https://github.com/pmd/pmd/releases/download/pmd_releases%2F${PMD_VERSION}/pmd-dist-${PMD_VERSION}-bin.zip" && \
    unzip -q /tmp/pmd.zip -d /opt && \
    ln -s /opt/pmd-bin-${PMD_VERSION}/bin/pmd /usr/local/bin/pmd && \
    rm /tmp/pmd.zip && \
    chmod -R a+rX /opt/pmd-bin-${PMD_VERSION}

# Verify
RUN java -version && gradle --version && pmd --version && angzarr codegen languages

WORKDIR /workspace
USER angzarr
