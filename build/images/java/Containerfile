# syntax=docker/dockerfile:1.4
# Java build image for angzarr.
#
# Provides: JDK 17, Gradle 8.5, protoc.
# Based on: ghcr.io/angzarr-io/angzarr-base (inherits fixuid + angzarr user)

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG TARGETARCH
ARG JAVA_VERSION=17
ARG GRADLE_VERSION=8.5

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-${JAVA_VERSION}-jdk-headless \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-${JAVA_VERSION}-openjdk-${TARGETARCH}
ENV PATH=${JAVA_HOME}/bin:${PATH}

# Gradle (system-wide; world-readable)
RUN curl -Lo /tmp/gradle.zip \
        "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" && \
    unzip -d /opt /tmp/gradle.zip && \
    ln -s /opt/gradle-${GRADLE_VERSION} /opt/gradle && \
    rm /tmp/gradle.zip && \
    chmod -R a+rX /opt/gradle*

ENV PATH=/opt/gradle/bin:$PATH

# PMD (per-method cyclomatic complexity; `just complexity`). Standalone CLI —
# no Gradle plugin needed. Symlinked onto PATH; world-readable for any uid.
ARG PMD_VERSION=7.21.0
RUN curl -fsSL -o /tmp/pmd.zip \
        "https://github.com/pmd/pmd/releases/download/pmd_releases%2F${PMD_VERSION}/pmd-dist-${PMD_VERSION}-bin.zip" && \
    unzip -q /tmp/pmd.zip -d /opt && \
    ln -s /opt/pmd-bin-${PMD_VERSION}/bin/pmd /usr/local/bin/pmd && \
    rm /tmp/pmd.zip && \
    chmod -R a+rX /opt/pmd-bin-${PMD_VERSION}

# Verify
RUN java -version && gradle --version && pmd --version

WORKDIR /workspace
USER angzarr
