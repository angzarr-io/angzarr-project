# syntax=docker/dockerfile:1.4
# Go build image for angzarr.
#
# Provides: Go toolchain, protoc-gen-go, protoc-gen-go-grpc, goimports.
# angzarr (codegen/scaffold protoc plugins) + buf are inherited from base.
# Based on: ghcr.io/angzarr-io/angzarr-base (inherits fixuid + angzarr user)

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG GO_VERSION=1.25.5

RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Go toolchain (system-wide)
RUN ARCH=$(dpkg --print-architecture) && \
    curl -Lo /tmp/go.tar.gz \
        "https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz" && \
    tar -C /usr/local -xzf /tmp/go.tar.gz && \
    rm /tmp/go.tar.gz

# Tool installs land in /usr/local/go-tools (NOT /root/go) so angzarr can use them
ENV GOPATH=/usr/local/go-tools \
    PATH=/usr/local/go/bin:/usr/local/go-tools/bin:$PATH

RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.6 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.5.1 && \
    go install golang.org/x/tools/cmd/goimports@latest && \
    go install github.com/fzipp/gocyclo/cmd/gocyclo@v0.6.0  # cyclomatic complexity (just complexity)

# Verify
RUN go version && protoc-gen-go --version && goimports -h 2>&1 | head -1 && angzarr codegen languages

# World-writable so runtime `go build` (under any fixuid-remapped uid)
# can refresh the module cache.
RUN chmod -R a+rwX /usr/local/go-tools

WORKDIR /workspace
USER angzarr
