# syntax=docker/dockerfile:1.4
# Python build image for angzarr.
#
# Provides: Python 3.11, uv, grpcio-tools, black, ruff, angzarr
# (codegen/scaffold protoc plugins).
# Based on: ghcr.io/angzarr-io/angzarr-base (inherits fixuid + angzarr user)

ARG BASE_IMAGE
# Pinned to the message-annotation recast branch tip (feat/codegen-message-
# annotation-recast); repoint to a main tag once that branch merges.
ARG ANGZARR_CLI_VERSION=6145d1f

# angzarr CLI built in a throwaway Go stage and copied in — buf invokes it as
# `angzarr codegen <lang>` / `angzarr scaffold <lang>`. The Python image has no
# Go toolchain, so it is compiled here and copied.
FROM golang:1.25-bookworm AS angzarr-builder
ARG ANGZARR_CLI_VERSION
RUN GOBIN=/out go install github.com/angzarr-io/angzarr-cli@${ANGZARR_CLI_VERSION} \
    && mv /out/angzarr-cli /out/angzarr

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG UV_VERSION=0.10.3

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-venv \
    python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

# uv to /usr/local/bin (avoid /root/.local — unreadable by angzarr)
RUN curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh \
    | env UV_INSTALL_DIR=/usr/local/bin INSTALLER_NO_MODIFY_PATH=1 sh

# grpcio-tools (system-wide; protoc plugin used during codegen)
RUN pip install --no-cache-dir --break-system-packages grpcio-tools

# black + ruff via uv tool (parked under /opt so angzarr can read; bins on PATH)
ENV UV_TOOL_DIR=/opt/uv-tools \
    UV_TOOL_BIN_DIR=/usr/local/bin
RUN mkdir -p $UV_TOOL_DIR && \
    uv tool install black && \
    uv tool install ruff && \
    uv tool install radon && \
    chmod -R a+rwX $UV_TOOL_DIR

COPY --from=angzarr-builder /out/angzarr /usr/local/bin/angzarr

# Verify
RUN python --version && uv --version && \
    python -c "import grpc_tools.protoc" && \
    black --version && ruff --version && radon --version && \
    angzarr codegen languages

WORKDIR /workspace
USER angzarr
