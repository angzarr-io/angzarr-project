# angzarr-ports: the shared storage contract and its conformance suite.
# Needs protoc on PATH (or PROTOC set, for angzarr-proto) and the
# wasm32-unknown-unknown target.

# Format check, build, lint and test natively, then the wasm32 builds and
# the wasm32 run of the suite on a store that is not Send
check: fmt-check build lint test wasm wasm-test

# The wasm test runner, pinned to the wasm-bindgen in Cargo.lock (the CLI
# and the library must match exactly). Installs into ~/.cargo/bin.
WASM_BINDGEN := "0.2.129"

# Install the tools `check` needs beyond rustup's: wasm-bindgen-test-runner
tools:
    #!/usr/bin/env bash
    set -euo pipefail
    have="$(wasm-bindgen-test-runner --version 2>/dev/null | awk '{print $2}' || true)"
    if [ "$have" != "{{WASM_BINDGEN}}" ]; then
        cargo install --locked wasm-bindgen-cli --version {{WASM_BINDGEN}}
    fi
    locked="$(grep -A1 '^name = "wasm-bindgen"$' Cargo.lock | sed -n 's/^version = "\(.*\)"/\1/p')"
    [ "$locked" = "{{WASM_BINDGEN}}" ] || { echo "Cargo.lock has wasm-bindgen $locked; WASM_BINDGEN is {{WASM_BINDGEN}}: bump them together" >&2; exit 1; }

fmt:
    cargo fmt

fmt-check:
    cargo fmt --check

build:
    cargo build --locked --all-features

lint:
    cargo clippy --locked --all-targets --all-features -- -D warnings

# The tests are the suite run against the reference backend: they need it
test:
    cargo test --locked --all-features

# The contract must build for the browser, suite and memory store included,
# and so must the suite's run on a store that is not Send (tests/wasm.rs).
# Running the wasm tests needs wasm-bindgen-test-runner: `just wasm-test`.
wasm:
    cargo build --locked --target wasm32-unknown-unknown
    cargo build --locked --target wasm32-unknown-unknown --all-features
    cargo test --locked --target wasm32-unknown-unknown --all-features --no-run

# Run the wasm tests: the suite on a store that is not Send (`just tools`
# installs the runner). Needs node on PATH.
wasm-test:
    CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER=wasm-bindgen-test-runner cargo test --locked --target wasm32-unknown-unknown --all-features --test wasm
